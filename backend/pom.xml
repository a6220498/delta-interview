<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.delta.interview</groupId>
  <artifactId>delta-interview-backend</artifactId>
  <version>1.0.0</version>
  <name>delta-interview-backend</name>
  <description>Spring Boot 3 backend generated from api/openapi.yaml</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <openapi-generator.version>7.25.0</openapi-generator.version>
    <springdoc.version>2.9.0</springdoc.version>
    <maven-toolchains-plugin.version>3.3.0</maven-toolchains-plugin.version>
    <!-- The contract lives at the monorepo root so both frontend and backend read the same file. -->
    <openapi.spec>${project.basedir}/../api/openapi.yaml</openapi.spec>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Serves the contract at /swagger-ui.html and backs the @Operation
         annotations emitted by the generator (documentationProvider=springdoc). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Pins the JDK used to compile, test and run, independently of whichever
           JDK Maven itself started on. Spring Boot 3.5.16 is documented as
           compatible up to Java 25, and Java 26 is a non-LTS release whose
           OpenJDK support ended in September 2026 — so the build must not
           quietly follow a newer default JDK.

           Resolved from ~/.m2/toolchains.xml or from Maven's JDK discovery,
           so nothing machine-specific is committed here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>${maven-toolchains-plugin.version}</version>
        <executions>
          <execution>
            <id>select-supported-jdk</id>
            <goals>
              <goal>select-jdk-toolchain</goal>
            </goals>
            <configuration>
              <version>[21,26)</version>
              <!-- IfMatch: use the JDK Maven is already running on only when it
                   satisfies the range above; otherwise select a toolchain, and
                   fail if none matches. Never silently falls back. -->
              <useJdk>IfMatch</useJdk>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Contract-first: regenerates the API interfaces and models from
           api/openapi.yaml on every build, before compile. The generated
           sources are build output (target/) and are never committed, so the
           YAML cannot drift from the Java. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-task-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${openapi.spec}</inputSpec>
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>com.delta.interview.api</apiPackage>
              <modelPackage>com.delta.interview.api.model</modelPackage>
              <generateApiTests>false</generateApiTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelTests>false</generateModelTests>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <!-- Emit interfaces only; we own the implementation. -->
                <interfaceOnly>true</interfaceOnly>
                <!-- No default method bodies: dropping an operation from the
                     controller then becomes a compile error rather than a
                     silent 501 at runtime. -->
                <skipDefaultInterface>true</skipDefaultInterface>
                <useSpringBoot3>true</useSpringBoot3>
                <useJakartaEe>true</useJakartaEe>
                <useTags>true</useTags>
                <useBeanValidation>true</useBeanValidation>
                <performBeanValidation>true</performBeanValidation>
                <!-- Plain Java types instead of JsonNullable wrappers; avoids
                     dragging in jackson-databind-nullable for one field. -->
                <openApiNullable>false</openApiNullable>
                <useOptional>false</useOptional>
                <dateLibrary>java8</dateLibrary>
                <documentationProvider>springdoc</documentationProvider>
                <annotationLibrary>swagger2</annotationLibrary>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Serve the contract itself at /openapi.yaml so Swagger UI shows the
           checked-in source of truth rather than a reconstructed spec. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-openapi-contract</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../api</directory>
                  <includes>
                    <include>openapi.yaml</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
